# Generated by bootstrap.sh into .env (never commit .env). Reference only.
PUID=1000
PGID=1000
DOCKER_GID=999
TZ=Europe/Berlin
PROJECTS_DIR=/home/youruser/dev-server/projects
PASSWORD='change-me'
# Set by bootstrap.sh when a tunnel token is given; enables the cloudflared service.
COMPOSE_PROFILES=tunnel
TUNNEL_TOKEN=
# Pinned versions; bump via commit, then ./bootstrap.sh --update
CODE_SERVER_VERSION=4.140.0-ls368
CLOUDFLARED_VERSION=2026.9.3

# Per-port hostnames for dev apps (optional; written by bootstrap.sh, see the README):
# PROXY_DOMAIN='{{port}}-dev.example.com'   # pattern; empty disables the feature
# DEV_PORTS='5173 8000 5000 3000 4173 5174' # ports that get a hostname
# DEV_ALLOWED_HOSTS='.example.com'          # derived: Vite accepts these hosts
