# Generated by bootstrap.sh into .env (never commit .env). Reference only.
PUID=1000
PGID=1000
DOCKER_GID=999
TZ=Europe/Berlin
PROJECTS_DIR=/home/youruser/dev-server/projects
PASSWORD='change-me'
# Set by bootstrap.sh when a tunnel token is given; enables the cloudflared service.
COMPOSE_PROFILES=tunnel
TUNNEL_TOKEN=
# Pinned versions; bump via commit, then ./bootstrap.sh --update
CODE_SERVER_VERSION=4.140.0-ls368
MARIADB_VERSION=11.8
CLOUDFLARED_VERSION=2026.9.3

# Per-port hostnames for dev apps (optional; written by bootstrap.sh, see the README):
# PROXY_DOMAIN='{{port}}-dev.example.com'   # pattern; empty disables the feature
# DEV_PORTS='5173 8000 5000 3000 4173 5174' # ports that get a hostname
# DEV_ALLOWED_HOSTS='.example.com'          # derived: Vite accepts these hosts

# Optional dev database (written by bootstrap.sh; see the README):
# DB_FORWARD='mariadb:3306'       # code-server forwards 127.0.0.1:3306 here; empty = no database
# MARIADB_ROOT_PASSWORD=...       # generated; used only when the data directory is created
# MARIADB_DEV_PASSWORD=...        # generated; the 'dev' user, also in config/mariadb-credentials.txt

# Agent dashboard (optional; written by bootstrap.sh --agents, see the README):
# AGENTS_HOST='agents.example.com'            # its hostname; tunnel route -> code-server:8790
# CODE_SERVER_URL='https://dev.example.com'   # the IDE, for "open in code-server" links
# CF_ACCESS_TEAM_DOMAIN='myteam.cloudflareaccess.com'  # Zero Trust > Settings
# CF_ACCESS_AUD='...'                         # AUD tag of the Access application (64 hex characters)
